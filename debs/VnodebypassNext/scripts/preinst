#!/bin/sh
set -eu
case "${1:-}" in
 install|upgrade)
  if [ -e /tmp/vnodebypass.txt ]; then
   echo 'Old vnode recovery journal exists. Disable using the old app, fully reboot, and re-jailbreak before upgrading.' >&2
   exit 1
  fi
  if [ ! -L /var/jb ] || [ ! -d /var/jb/basebin ]; then
   echo 'Dopamine rootless environment is not ready; restore it in Dopamine before installing.' >&2
   exit 1
  fi
  ;;
esac
exit 0
