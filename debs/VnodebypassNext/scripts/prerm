#!/bin/sh
set -eu
case "${1:-}" in
 remove|upgrade|deconfigure)
  if [ -x /var/jb/usr/bin/vnodebypass ]; then
   if ! /var/jb/usr/bin/vnodebypass disable; then
    echo 'Restore did not complete. Fully reboot and re-jailbreak before removing/upgrading; recovery journal preserved.' >&2
    exit 1
   fi
  fi
  ;;
esac
exit 0
