<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>title</key>
	<string>CPUthermal</string>
	<key>items</key>
	<array>
		<!-- ===================== 第1组: 功率模式 ===================== -->
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>用户手动选择的“低功耗”或“解除温控”会作为常驻模式保存。设备熄屏/锁屏时运行状态临时切到 PowerSave 与 CPU Level 2，但不改写用户选择；亮屏/解锁后恢复锁屏前的对应模式。解除温控继续按当前设置处理 CPU/GPU/Package 功率策略。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSegmentCell</string>
			<key>default</key>
			<string>fullPower</string>
			<key>defaults</key>
			<string>com.huayuarc.cputhermal</string>
			<key>key</key>
			<string>powerMode</string>
			<key>label</key>
			<string>功率模式</string>
			<key>validTitles</key>
			<array>
				<string>低功耗</string>
				<string>解除温控</string>
			</array>
			<key>validValues</key>
			<array>
				<string>lowPower</string>
				<string>fullPower</string>
			</array>
		</dict>

		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>footerText</key><string>默认关闭。开启后在解除温控模式中锁定 CPU Floor 100，并强制 GPU/Package Ceiling 100；适合游戏和跑分。关闭后 CPU Floor 归零且 GPU/Package 恢复系统调度，降低日常发热。</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>default</key><false/>
			<key>defaults</key><string>com.huayuarc.cputhermal</string>
			<key>key</key><string>highPerformanceModeEnabled</string>
			<key>label</key><string>高性能满功率模式</string>
		</dict>

		<!-- ===================== 第2组: 温度计警告 ===================== -->
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>开启后阻止全屏「iPhone 需要冷却」警告及其高温强制锁屏行为；关闭后恢复系统原生提示与保护。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<false/>
			<key>defaults</key>
			<string>com.huayuarc.cputhermal</string>
			<key>key</key>
			<string>thermalBlockNotifPopup</string>
			<key>label</key>
			<string>屏蔽高温温度计警告</string>
		</dict>

		<!-- ===================== 第3组: 屏幕控制 ===================== -->
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>按 Insulation 的 backlightComponentControl 结构，将 BacklightBrightness/BacklightPower 后续热档位恢复为第0档无热限制值，并关闭背光 CPMS。动态拦截 IOMFB 明确亮度上限；亮度0、Sleep、Blank、PowerState 等自动锁定写入保持原样。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<false/>
			<key>defaults</key>
			<string>com.huayuarc.cputhermal</string>
			<key>key</key>
			<string>thermalPreventDimmingEnabled</string>
			<key>label</key>
			<string>防温控暗屏</string>
		</dict>

		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>footerText</key><string>开启后，SpringBoard 检测到设备屏幕朝下时模拟按下锁屏键。仅注入 SpringBoard，默认关闭。</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>default</key><false/>
			<key>defaults</key><string>com.huayuarc.cputhermal</string>
			<key>key</key><string>lockWhenFaceDown</string>
			<key>label</key><string>设备朝下自动锁屏</string>
		</dict>

		<!-- ===================== 第4组: 电池提示 ===================== -->
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>开启后隐藏设置首页及“通用 → 关于本机”中的部件与服务历史，覆盖电池、屏幕、相机等未知/更换部件记录，并保留电池健康页面显示。关闭后恢复系统原生记录。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<false/>
			<key>defaults</key>
			<string>com.huayuarc.cputhermal</string>
			<key>key</key>
			<string>suppressBatteryServiceWarnings</string>
			<key>label</key>
			<string>屏蔽部件与维修记录</string>
		</dict>

		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>开启后将系统“电池健康与充电”页面的最大容量模拟显示为 100%，并在切换时一次性尝试将 AppleSmartBattery 标称容量与当前设备 DesignCapacity 对齐。不再定时重写，不向所有应用注入基础字典 Hook。部分第三方工具直接读取驱动实时值，仍可能显示真实健康度；关闭后按隐根备份恢复真实容量。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<false/>
			<key>defaults</key>
			<string>com.huayuarc.cputhermal</string>
			<key>key</key>
			<string>simulateMaximumCapacity</string>
			<key>label</key>
			<string>模拟最大容量 100%</string>
		</dict>

		<!-- ===================== SmartBatteryAPI 智能停充 ===================== -->
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>label</key><string>SmartBatteryAPI 智能停充</string>
			<key>footerText</key><string>达到所选电量后自动停止充电并禁流；电量降低 5% 后自动恢复，避免临界电量反复启停。</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>default</key><false/>
			<key>defaults</key><string>com.huayuarc.cputhermal</string>
			<key>key</key><string>smartChargeEnabled</string>
			<key>label</key><string>智能停充</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSegmentCell</string>
			<key>default</key><integer>80</integer>
			<key>defaults</key><string>com.huayuarc.cputhermal</string>
			<key>key</key><string>smartChargeStopLevel</string>
			<key>label</key><string>停充电量</string>
			<key>validTitles</key><array><string>70%</string><string>75%</string><string>80%</string><string>85%</string><string>90%</string><string>95%</string><string>100%</string></array>
			<key>validValues</key><array><integer>70</integer><integer>75</integer><integer>80</integer><integer>85</integer><integer>90</integer><integer>95</integer><integer>100</integer></array>
		</dict>

		<!-- ===================== 挂载路径管理 ===================== -->
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>管理 ThermalMonitor 等路径的可读写挂载；通过后台守护与动态 RootHide 后备目录实现，不会修改只读系统分区。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSLinkCell</string>
			<key>detail</key>
			<string>CPUthermalMountListController</string>
			<key>isController</key>
			<true/>
			<key>label</key>
			<string>挂载路径管理</string>
		</dict>

		<!-- ===================== 第5组: 操作 ===================== -->
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>安装或升级时会自动重启 thermalmonitord 载入插件；此处按钮用于手动重启整个用户空间。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>重启用户空间</string>
			<key>action</key>
			<string>usreboot</string>
		</dict>

		<!-- ===================== 第7组: 开源代码 ===================== -->
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>开源</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>GitHub be-huge/insulation</string>
			<key>action</key>
			<string>openSourceCode</string>
		</dict>
	</array>
</dict>
</plist>
