<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>title</key>
	<string>CPUthermal</string>
	<key>items</key>
	<array>
		<!-- ===================== 第1组: 功率模式 ===================== -->
		<dict>
			<key>cell</key>
			<string>PSSegmentCell</string>
			<key>default</key>
			<string>fullPower</string>
			<key>defaults</key>
			<string>com.huayuarc.cputhermal</string>
			<key>key</key>
			<string>powerMode</string>
			<key>label</key>
			<string>功率模式</string>
			<key>validTitles</key>
			<array>
				<string>低功耗</string>
				<string>解除温控</string>
			</array>
			<key>validValues</key>
			<array>
				<string>lowPower</string>
				<string>fullPower</string>
			</array>
		</dict>
		<!-- ===================== 第2组: 温度计警告 ===================== -->
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<false/>
			<key>defaults</key>
			<string>com.huayuarc.cputhermal</string>
			<key>key</key>
			<string>thermalBlockNotifPopup</string>
			<key>label</key>
			<string>屏蔽高温温度计警告</string>
		</dict>

		<!-- ===================== 第3组: 屏幕控制 ===================== -->
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<false/>
			<key>defaults</key>
			<string>com.huayuarc.cputhermal</string>
			<key>key</key>
			<string>thermalPreventDimmingEnabled</string>
			<key>label</key>
			<string>防温控暗屏</string>
		</dict>

		<!-- ===================== 第4组: 电池提示 ===================== -->
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<false/>
			<key>defaults</key>
			<string>com.huayuarc.cputhermal</string>
			<key>key</key>
			<string>suppressBatteryServiceWarnings</string>
			<key>label</key>
			<string>屏蔽电池维修提示</string>
		</dict>

		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<false/>
			<key>defaults</key>
			<string>com.huayuarc.cputhermal</string>
			<key>key</key>
			<string>simulateMaximumCapacity</string>
			<key>label</key>
			<string>模拟最大容量 100%</string>
		</dict>

		<!-- ===================== 电池充电温度检测 ===================== -->
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>label</key><string>电池充电温度检测</string>
			<key>footerText</key><string>仅在 powerd 内把电池充电决策温度归一为 32°C，并拦截高温停充标志；不注入 thermalmonitord。智能停充达到指定电量时拥有最高优先级，仍会停止电流并断开外部电源。</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>default</key><false/>
			<key>defaults</key><string>com.huayuarc.cputhermal</string>
			<key>key</key><string>bypassBatteryChargeTemperature</string>
			<key>label</key><string>屏蔽电池充电温度检测</string>
		</dict>

		<!-- ===================== 智能停充 ===================== -->
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>label</key><string>SmartBatteryAPI 智能停充</string>
			<key>footerText</key><string>达到所选电量后停止充电电流，同时写入外部电源断开状态并去除充电图标；保持断流直到用户真实拔出再插入，或电量自然降低 5% 后兜底恢复。拔插恢复后的本轮充电不立即重复断流。</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>default</key><false/>
			<key>defaults</key><string>com.huayuarc.cputhermal</string>
			<key>key</key><string>smartChargeEnabled</string>
			<key>label</key><string>智能停充</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSegmentCell</string>
			<key>default</key><integer>80</integer>
			<key>defaults</key><string>com.huayuarc.cputhermal</string>
			<key>key</key><string>smartChargeStopLevel</string>
			<key>label</key><string>停充电量</string>
			<key>validTitles</key><array><string>70%</string><string>75%</string><string>80%</string><string>85%</string><string>90%</string><string>95%</string><string>100%</string></array>
			<key>validValues</key><array><integer>70</integer><integer>75</integer><integer>80</integer><integer>85</integer><integer>90</integer><integer>95</integer><integer>100</integer></array>
		</dict>

		<!-- ===================== ProMotion 刷新率 ===================== -->
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>label</key><string>ProMotion 刷新率</string>
			<key>footerText</key><string>强制 120Hz 仅作用于支持 ProMotion 的设备。温度保护开启时，系统达到严重温控状态或电池温度达到 43°C 会自动回落 60Hz。</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>default</key><false/>
			<key>defaults</key><string>com.huayuarc.cputhermal</string>
			<key>key</key><string>force120HzEnable</string>
			<key>label</key><string>强制 120Hz</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>default</key><true/>
			<key>defaults</key><string>com.huayuarc.cputhermal</string>
			<key>key</key><string>refreshThermalProtectionEnabled</string>
			<key>label</key><string>120Hz 温度保护</string>
		</dict>

		<!-- ===================== 挂载路径管理 ===================== -->
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSLinkCell</string>
			<key>label</key>
			<string>挂载路径管理</string>
			<key>detail</key>
			<string>CPUthermalMountListController</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSLinkCell</string>
			<key>label</key>
			<string>指定应用低功耗</string>
			<key>detail</key>
			<string>CPUthermalAppListController</string>
		</dict>

		<!-- ===================== 第5组: 操作 ===================== -->
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>重启用户空间</string>
			<key>action</key>
			<string>usreboot</string>
		</dict>

		<!-- ===================== 第7组: 开源代码 ===================== -->
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>开源</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>GitHub be-huge/insulation</string>
			<key>action</key>
			<string>openSourceCode</string>
		</dict>
	</array>
</dict>
</plist>
