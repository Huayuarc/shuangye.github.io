<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>title</key>
	<string>CPUthermal</string>
	<key>items</key>
	<array>
		<!-- ===================== 第1组: 功率模式 ===================== -->
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>低功耗模式启用 PowerSave 并将 CPU Level 设为 2。解除温控模式继续伪造 Nominal、拦截 thermalmonitord 用户态热决策并屏蔽降频，但已取消每秒保活和重复通知；内核与硬件紧急保护不受插件控制。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSegmentCell</string>
			<key>default</key>
			<string>fullPower</string>
			<key>defaults</key>
			<string>com.huayuarc.cputhermal</string>
			<key>key</key>
			<string>powerMode</string>
			<key>label</key>
			<string>功率模式</string>
			<key>validTitles</key>
			<array>
				<string>低功耗</string>
				<string>解除温控</string>
			</array>
			<key>validValues</key>
			<array>
				<string>lowPower</string>
				<string>fullPower</string>
			</array>
		</dict>
		<!-- ===================== 第2组: 温度计警告 ===================== -->
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>开启后阻止系统因高温弹出全屏「iPhone 需要冷却」温度计警告。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.huayuarc.cputhermal</string>
			<key>key</key>
			<string>thermalBlockNotifPopup</string>
			<key>label</key>
			<string>屏蔽高温温度计警告</string>
		</dict>

		<!-- ===================== 第3组: 屏幕控制 ===================== -->
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>开启后阻止系统因温控主动调暗屏幕亮度，保持当前亮度不变。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<false/>
			<key>defaults</key>
			<string>com.huayuarc.cputhermal</string>
			<key>key</key>
			<string>thermalPreventDimmingEnabled</string>
			<key>label</key>
			<string>防温控暗屏</string>
		</dict>

		<!-- ===================== 第4组: 操作 ===================== -->
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>仅在手动确认后重启用户空间；插件本身不会自动终止 thermalmonitord。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>重启用户空间</string>
			<key>action</key>
			<string>usreboot</string>
		</dict>

		<!-- ===================== 第5组: 开源代码 ===================== -->
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>开源</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>GitHub be-huge/insulation</string>
			<key>action</key>
			<string>openSourceCode</string>
		</dict>
	</array>
</dict>
</plist>
