<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>title</key>
	<string>CPUthermal</string>
	<key>items</key>
	<array>
		<!-- ===================== 第1组: 功率模式 ===================== -->
		<dict>
			<key>cell</key>
			<string>PSSegmentCell</string>
			<key>default</key>
			<string>fullPower</string>
			<key>defaults</key>
			<string>com.huayuarc.cputhermal</string>
			<key>key</key>
			<string>powerMode</string>
			<key>label</key>
			<string>功率模式</string>
			<key>validTitles</key>
			<array>
				<string>低功耗</string>
				<string>解除温控</string>
			</array>
			<key>validValues</key>
			<array>
				<string>lowPower</string>
				<string>fullPower</string>
			</array>
		</dict>
		<!-- ===================== 第2组: 温度计警告 ===================== -->
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<false/>
			<key>defaults</key>
			<string>com.huayuarc.cputhermal</string>
			<key>key</key>
			<string>thermalBlockNotifPopup</string>
			<key>label</key>
			<string>屏蔽高温温度计警告</string>
		</dict>

		<!-- ===================== 第3组: 屏幕控制 ===================== -->
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<false/>
			<key>defaults</key>
			<string>com.huayuarc.cputhermal</string>
			<key>key</key>
			<string>thermalPreventDimmingEnabled</string>
			<key>label</key>
			<string>防温控暗屏</string>
		</dict>

		<!-- ===================== 第4组: 电池提示 ===================== -->
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<false/>
			<key>defaults</key>
			<string>com.huayuarc.cputhermal</string>
			<key>key</key>
			<string>suppressBatteryServiceWarnings</string>
			<key>label</key>
			<string>屏蔽电池维修提示</string>
		</dict>

		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<false/>
			<key>defaults</key>
			<string>com.huayuarc.cputhermal</string>
			<key>key</key>
			<string>simulateMaximumCapacity</string>
			<key>label</key>
			<string>模拟最大容量 100%</string>
		</dict>

		<!-- ===================== 电池充电温度检测 ===================== -->
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>footerText</key><string>开启后在 powerd 将充电决策温度固定为 32°C，并持续清除充电抑制位，实现强制满血快充；不注入 thermalmonitord，也不改 CPU/GPU 功耗。</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>default</key><false/>
			<key>defaults</key><string>com.huayuarc.cputhermal</string>
			<key>key</key><string>bypassBatteryChargeTemperature</string>
			<key>label</key><string>屏蔽电池充电温度检测</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>default</key><false/>
			<key>defaults</key><string>com.huayuarc.cputhermal</string>
			<key>key</key><string>forceFastChargeIgnoreHeat</string>
			<key>label</key><string>强制满血快充（无视发热）</string>
		</dict>

		<!-- ===================== ProMotion 刷新率 ===================== -->
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>label</key><string>ProMotion 刷新率</string>
			<key>footerText</key><string>强制应用与系统动画请求 120Hz；设备必须原生支持 120Hz。开启后无视温度与系统热状态；系统录屏期间暂停插件私有刷新驱动并交由系统录屏控制，录屏结束自动恢复 120Hz。</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>default</key><false/>
			<key>defaults</key><string>com.huayuarc.cputhermal</string>
			<key>key</key><string>force120Hz</string>
			<key>label</key><string>强制 120Hz</string>
		</dict>

		<!-- ===================== 刷新率排除应用 ===================== -->
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>footerText</key><string>选择不注入刷新率模块的第三方应用。开启列表项后，该应用恢复自身原生刷新率调度。</string>
		</dict>
		<dict>
			<key>cell</key><string>PSLinkCell</string>
			<key>label</key><string>选择三方应用不注入刷新率</string>
			<key>detail</key><string>CPUthermalRefreshExcludeController</string>
		</dict>

		<!-- ===================== 挂载路径管理 ===================== -->
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSLinkCell</string>
			<key>label</key>
			<string>挂载路径管理</string>
			<key>detail</key>
			<string>CPUthermalMountListController</string>
		</dict>

		<!-- ===================== 第5组: 操作 ===================== -->
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>重启用户空间</string>
			<key>action</key>
			<string>usreboot</string>
		</dict>

		<!-- ===================== 第7组: 开源代码 ===================== -->
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>开源</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>GitHub be-huge/insulation</string>
			<key>action</key>
			<string>openSourceCode</string>
		</dict>
	</array>
</dict>
</plist>
