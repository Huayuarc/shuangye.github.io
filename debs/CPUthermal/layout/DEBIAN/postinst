#!/bin/sh
case "$1" in
configure)
killall -q thermalmonitord 2>/dev/null || true
# 诊断日志已移除：清掉历史日志文件
rm -rf /var/jb/Library/ControlCenter/Bundles/CPUthermalCC.bundle /var/jb/Library/ControlCenter/Bundles/CPUthermalCC1x1.bundle /Library/ControlCenter/Bundles/CPUthermalCC.bundle /Library/ControlCenter/Bundles/CPUthermalCC1x1.bundle 2>/dev/null || true
rm -f /var/tmp/cputhermal-*.log /var/jb/var/tmp/cputhermal-*.log 2>/dev/null || true


# 智能停充守护：已有服务重启读取新配置，首次安装执行 bootstrap。
if launchctl print system/com.huayuarc.cputhermal.charge >/dev/null 2>&1; then
    launchctl kickstart -k system/com.huayuarc.cputhermal.charge >/dev/null 2>&1 || true
else
    launchctl bootstrap system /var/jb/Library/LaunchDaemons/com.huayuarc.cputhermal.charge.plist >/dev/null 2>&1 || true
fi
;;
esac
exit 0
