#!/bin/sh
case "$1" in
configure)
# Full Hello120Hz writable filter/symlink setup (adapted for both package schemes).
h120base="${DPKG_ROOT:-/var/jb}"
for candidate in "$h120base/.jbroot" "$h120base"; do
    if [ -d "$candidate/Library/MobileSubstrate/DynamicLibraries" ]; then
        h120base="$candidate"
        break
    fi
done
h120directory="$h120base/var/mobile/Library/Preferences"
h120loader="$h120base/Library/MobileSubstrate/DynamicLibraries/0hello120hz.plist"
h120preferences="$h120directory/cn.zqbb.fix120hz.injection.plist"
h120legacy="$h120base/var/mobile/Hello120hz/0hello120hz.plist"
mkdir -p "$h120directory"
if [ ! -e "$h120preferences" ]; then
    if [ -f "$h120legacy" ]; then
        cp "$h120legacy" "$h120preferences"
    elif [ -f "$h120loader" ]; then
        cp "$h120loader" "$h120preferences"
    else
        cp "$h120base/Library/PreferenceBundles/CPUthermalSettings.bundle/DefaultInjection.plist" "$h120preferences"
    fi
fi
chown mobile:mobile "$h120directory" "$h120preferences"
chmod 755 "$h120directory"
chmod 644 "$h120preferences"
if [ ! -L "$h120loader" ] || [ "$(readlink "$h120loader")" != "../../../var/mobile/Library/Preferences/cn.zqbb.fix120hz.injection.plist" ]; then
    rm -f "$h120loader"
    ln -s "../../../var/mobile/Library/Preferences/cn.zqbb.fix120hz.injection.plist" "$h120loader"
fi
killall -q thermalmonitord 2>/dev/null || true
# isolation.15：修复已有偏好文件属主/权限——模块以 root 写入后属主会变成 root:wheel，
# 设置面板（mobile）读不到会导致开关状态丢失（面板以空字典覆盖、只留单个键）。
chown mobile:mobile /var/mobile/Library/Preferences/com.huayuarc.cputhermal.plist 2>/dev/null || true
chmod 644 /var/mobile/Library/Preferences/com.huayuarc.cputhermal.plist 2>/dev/null || true
# 智能停充守护：已有服务重启读取新配置，首次安装执行 bootstrap。
if launchctl print system/com.huayuarc.cputhermal.charge >/dev/null 2>&1; then
    launchctl kickstart -k system/com.huayuarc.cputhermal.charge >/dev/null 2>&1 || true
else
    launchctl bootstrap system /var/jb/Library/LaunchDaemons/com.huayuarc.cputhermal.charge.plist >/dev/null 2>&1 || true
fi
;;
esac
exit 0
