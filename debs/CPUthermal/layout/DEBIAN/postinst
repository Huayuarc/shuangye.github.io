#!/bin/sh
case "$1" in
configure)
killall -q thermalmonitord 2>/dev/null || true
# Mount daemon must be explicitly registered on fresh install/reinstall. Upgrade only kickstarts it.
if launchctl print system/com.huayuarc.cputhermal.mount >/dev/null 2>&1; then
    launchctl kickstart -k system/com.huayuarc.cputhermal.mount >/dev/null 2>&1 || true
else
    launchctl bootstrap system /var/jb/Library/LaunchDaemons/com.huayuarc.cputhermal.mount.plist >/dev/null 2>&1 || true
fi
;;
esac
exit 0
