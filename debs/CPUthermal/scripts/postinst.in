#!/bin/sh
case "$1" in
configure)
killall -q thermalmonitord 2>/dev/null || true
# 控制中心模块已移除（156，单模式无需切换）：清理设备上已安装的旧 bundle
rm -rf @JBROOT@/Library/ControlCenter/Bundles/CPUthermalCC.bundle \
       @JBROOT@/Library/ControlCenter/Bundles/CPUthermalCC1x1.bundle 2>/dev/null || true
# 诊断日志已移除（156）：清掉历史日志文件
rm -f /var/tmp/cputhermal-*.log @JBROOT@/var/tmp/cputhermal-*.log 2>/dev/null || true
# 智能停充守护：已有服务重启读取新配置，首次安装执行 bootstrap。
if launchctl print system/com.huayuarc.cputhermal.charge >/dev/null 2>&1; then
    launchctl kickstart -k system/com.huayuarc.cputhermal.charge >/dev/null 2>&1 || true
else
    launchctl bootstrap system @JBROOT@/Library/LaunchDaemons/com.huayuarc.cputhermal.charge.plist >/dev/null 2>&1 || true
fi
;;
esac
exit 0
