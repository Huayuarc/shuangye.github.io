#!/bin/sh
case "$1" in
configure)
killall -q thermalmonitord 2>/dev/null || true
# 每次安装/升级确保 mount daemon 已注册：已有服务仅 kickstart，首次才 bootstrap。
if launchctl print system/com.huayuarc.cputhermal.mount >/dev/null 2>&1; then
    launchctl kickstart -k system/com.huayuarc.cputhermal.mount >/dev/null 2>&1 || true
else
    launchctl bootstrap system @JBROOT@/Library/LaunchDaemons/com.huayuarc.cputhermal.mount.plist >/dev/null 2>&1 || true
fi
;;
esac
exit 0
