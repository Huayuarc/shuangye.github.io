#!/bin/sh
# CPUthermal postinst
# 精简安装脚本：只重启 thermalmonitord，让新注入的温控核心尽快生效。
# 刻意不在安装时执行 launchctl bootout/bootstrap 或 killall powerd——
# 这些会卸载正在运行的守护/重启充电握手，在 iOS15/A10 上可触发瞬时黑屏或需双击电源键唤醒。
# mount 后台 LaunchDaemon 由 KeepAlive 自愈，无需在 postinst 干预。
case "$1" in
configure)
# 仅在挂载守护尚未登记时补加载；不 bootout，不重启 powerd/SpringBoard。
launchctl print system/com.huayuarc.cputhermal.mount >/dev/null 2>&1 || launchctl bootstrap system @JBROOT@/Library/LaunchDaemons/com.huayuarc.cputhermal.mount.plist 2>/dev/null || true
killall -q thermalmonitord 2>/dev/null || true
;;
esac
exit 0
