#!/bin/sh
case "$1" in
remove|deconfigure)
@JBROOT@/usr/local/bin/CPUthermalChargeTool reset 2>/dev/null || true
# 守护仍在线时先卸载全部 bindfs，再删除挂载记录、调度备份、后备文件和临时 IPC。
@JBROOT@/usr/local/bin/CPUthermalMountTool cleanup-all 2>/dev/null || true
launchctl bootout system/com.huayuarc.cputhermal.charge 2>/dev/null || true
launchctl bootout system/com.huayuarc.cputhermal.mount 2>/dev/null || true
# 兜底：工具缺失/旧包升级时清除当前方案固定目录（绝不删除 /System 原目录）。
rm -rf @JBROOT@/var/lib/cputhermal-mount @JBROOT@/var/lib/cputhermal-scheduler-backup 2>/dev/null || true
;;
esac
exit 0
