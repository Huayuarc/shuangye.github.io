#!/bin/bash

# CPUthermal prerm — 卸载/升级前脚本（在文件被删除前运行）
#
# 目的：此时 dylib 仍加载在 thermalmonitord 进程内，插件钩子依然生效。
#       在文件被删之前先把硬件恢复到全功率状态，避免卸载后
#       低功耗 keep-alive 写入 IORegistry 的目标残留导致 CPU 被锁频。
#
# 恢复方式：① CPUthermalTool restore-fullpower（内部路径最可靠）
#           ② 回退：defaults 写偏好 + notifyutil 发通知 + 等待插件恢复

# 兼容 rootless / roothide / rootful：定位可执行工具
resolve_bin() {
    for p in "$@"; do
        if [ -x "$p" ]; then
            printf '%s\n' "$p"
            return 0
        fi
    done
    printf '%s\n' "$1"
}

DEFAULTS="$(resolve_bin /var/jb/usr/bin/defaults /usr/bin/defaults)"
NOTIFYUTIL="$(resolve_bin /var/jb/usr/bin/notifyutil /usr/bin/notifyutil)"
TOOL="$(resolve_bin /var/jb/usr/local/bin/CPUthermalTool /usr/local/bin/CPUthermalTool)"

# 偏好文件可能存在的路径（rootless 在 /var/jb，rootful 在根路径）
PREF_JB="/var/jb/var/mobile/Library/Preferences/com.huayuarc.CPUthermal.plist"
PREF_ROOTFS="/var/mobile/Library/Preferences/com.huayuarc.CPUthermal.plist"

restore_fullpower() {
    # ① 优先使用 CPUthermalTool（自动定位正确偏好路径，等待 3s）
    if [ -x "$TOOL" ]; then
        "$TOOL" restore-fullpower 2>/dev/null && return 0
    fi

    # ② 回退方案：向所有可能的偏好路径写入 fullPower，并发通知
    for plist in "$PREF_JB" "$PREF_ROOTFS"; do
        mkdir -p "$(dirname "$plist")" 2>/dev/null
        "$DEFAULTS" write "$plist" powerMode "fullPower" 2>/dev/null
    done
    "$NOTIFYUTIL" -p "com.huayuarc.CPUthermal/powerModeChanged" 2>/dev/null

    # 等待插件 keep-alive 周期把硬件恢复到全功率
    sleep 3
}

case "$1" in
    remove|deconfigure)
        restore_fullpower
        ;;
    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        # 升级/中断：保留配置，不做恢复
        ;;
esac

exit 0
