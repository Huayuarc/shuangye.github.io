#!/bin/bash

# CPUthermal prerm
# 卸载/升级前恢复硬件全功率状态
# 执行时机：在文件被删除之前运行，此时 dylib 仍在 thermalmonitord 进程中加载

case "$1" in
    remove|deconfigure)
        # Step 1: 通过 CPUthermalTool 写偏好 + 发通知 + 等待硬件恢复
        TOOL_PATH=""
        for p in /usr/local/bin/CPUthermalTool /var/jb/usr/local/bin/CPUthermalTool; do
            if [ -x "$p" ]; then
                TOOL_PATH="$p"
                break
            fi
        done

        if [ -n "$TOOL_PATH" ]; then
            "$TOOL_PATH" restore-fullpower
            RET=$?
            if [ $RET -eq 0 ]; then
                exit 0
            fi
        fi

        # Step 2: 回退方案 — 直接用 defaults + notifyutil
        PLIST="/var/mobile/Library/Preferences/com.huayuarc.CPUthermal.plist"
        mkdir -p "$(dirname "$PLIST")" 2>/dev/null || true

        # 写偏好
        if [ -x /usr/bin/defaults ]; then
            /usr/bin/defaults write "$PLIST" powerMode "fullPower" 2>/dev/null
        elif [ -x /var/jb/usr/bin/defaults ]; then
            /var/jb/usr/bin/defaults write "$PLIST" powerMode "fullPower" 2>/dev/null
        fi

        # 发通知
        if [ -x /usr/bin/notifyutil ]; then
            /usr/bin/notifyutil -p "com.huayuarc.CPUthermal/powerModeChanged" 2>/dev/null
        elif [ -x /var/jb/usr/bin/notifyutil ]; then
            /var/jb/usr/bin/notifyutil -p "com.huayuarc.CPUthermal/powerModeChanged" 2>/dev/null
        fi

        # 等待插件恢复硬件
        sleep 3
        ;;
    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;
esac
exit 0
