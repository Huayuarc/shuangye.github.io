#!/bin/bash

# CPUthermal postinst
# 安装/升级完成后重启 thermalmonitord 使 tweak 生效

case "$1" in
    configure)
        # 重启 thermalmonitord（launchd 会自动重启，加载新的 tweak）
        killall -q thermalmonitord 2>/dev/null || true

        # 确保看门狗守护进程启动（如果 thermalmonitord 尚未重启或 %ctor 未执行）
        # 使用独立进程，不受启动时序影响
        WATCHDOG="/usr/local/bin/CPUthermalTool"
        if [ ! -x "$WATCHDOG" ]; then
            WATCHDOG="/var/jb/usr/local/bin/CPUthermalTool"
        fi
        if [ -x "$WATCHDOG" ]; then
            # 先终止旧看门狗
            pids=$(pgrep -f "CPUthermalTool.*watch-plist" 2>/dev/null)
            if [ -n "$pids" ]; then
                kill $pids 2>/dev/null
                sleep 0.1
            fi
            # 启动新看门狗（后台运行）
            "$WATCHDOG" --watch-plist \
                "/var/mobile/Library/Preferences/com.huayuarc.cputhermal-prefs.plist" \
                >/dev/null 2>&1 &
        fi
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
esac

exit 0
