<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>恢复 Apple 原生温控策略，阻止系统对 CPU 进行额外降频。</string>
			<key>label</key>
			<string>温控管理</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>开启后阻止系统因温控主动调暗屏幕亮度，保持当前亮度不变。</string>
			<key>label</key>
			<string>屏幕控制</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.huayuarc.cputhermal-prefs</string>
			<key>key</key>
			<string>thermalPreventDimmingEnabled</string>
			<key>label</key>
			<string>防温控暗屏</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>重启用户空间将继续使用当前系统版本，无需重新越狱。此操作会强制关闭所有应用并重新加载系统环境。</string>
			<key>label</key>
			<string>系统工具</string>
		</dict>
		<dict>
			<key>action</key>
			<string>userspaceRebootTapped:</string>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>重启用户空间</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>开源代码</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>action</key>
			<string>openSourceCode</string>
			<key>label</key>
			<string>GitHub - be-huge/insulation</string>
			<key>url</key>
			<string>https://github.com/be-huge/insulation</string>
		</dict>
	</array>
	<key>title</key>
	<string>CPU 去温控</string>
</dict>
</plist>
