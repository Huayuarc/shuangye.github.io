<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>title</key>
	<string>CPUthermal</string>
	<key>items</key>
	<array>
		<!-- ===================== 第1组: 功率模式 ===================== -->
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>低功耗 = 限制 CPU 性能档位以省电；解除温控 = 解除全部温控降频限制</string>
		</dict>
		<dict>
			<key>PostNotification</key>
			<string>com.huayuarc.cputhermal/powerModeChanged</string>
			<key>cell</key>
			<string>PSSegmentCell</string>
			<key>default</key>
			<string>fullPower</string>
			<key>defaults</key>
			<string>com.huayuarc.cputhermal</string>
			<key>key</key>
			<string>powerMode</string>
			<key>label</key>
			<string>功率模式</string>
			<key>validTitles</key>
			<array>
				<string>低功耗</string>
				<string>解除温控</string>
			</array>
			<key>validValues</key>
			<array>
				<string>lowPower</string>
				<string>fullPower</string>
			</array>
		</dict>

		<!-- ===================== 温控锁定CPU频率值 ===================== -->
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>温控锁定CPU频率值</string>
			<key>footerText</key>
			<string>由于无法从硬件中读取到真实的CPU最大频率，所以频率需要自己输入，然后重启用户空间、或者重新安装一下插件即可生效。（不建议过小以及过大，按照CPU合理范围填写就行，否则可能存在隐患。）</string>
		</dict>
		<dict>
			<key>PostNotification</key>
			<string>com.huayuarc.cputhermal/settingsChanged</string>
			<key>cell</key>
			<string>PSEditTextCell</string>
			<key>default</key>
			<string></string>
			<key>defaults</key>
			<string>com.huayuarc.cputhermal</string>
			<key>key</key>
			<string>cpuMinPowerValue</string>
			<key>keyboard</key>
			<string>numbers</string>
			<key>isNumeric</key>
			<string>true</string>
			<key>placeholder</key>
			<string>仅支持数字，否则不生效。</string>
		</dict>

		<!-- ===================== 第2组: 温度计警告 ===================== -->
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>开启后阻止系统因高温弹出全屏「iPhone 需要冷却」温度计警告。</string>
		</dict>
		<dict>
			<key>PostNotification</key>
			<string>com.huayuarc.cputhermal/settingsChanged</string>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.huayuarc.cputhermal</string>
			<key>key</key>
			<string>thermalBlockNotifPopup</string>
			<key>label</key>
			<string>屏蔽高温温度计警告</string>
		</dict>

		<!-- ===================== 第3组: 屏幕控制 ===================== -->
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>开启后阻止系统因温控主动调暗屏幕亮度，保持当前亮度不变。</string>
		</dict>
		<dict>
			<key>PostNotification</key>
			<string>com.huayuarc.cputhermal/settingsChanged</string>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.huayuarc.cputhermal</string>
			<key>key</key>
			<string>thermalPreventDimmingEnabled</string>
			<key>label</key>
			<string>防温控暗屏</string>
		</dict>

		<!-- ===================== 第4组: 操作 ===================== -->
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>操作</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>重启用户空间</string>
			<key>action</key>
			<string>usreboot</string>
		</dict>

		<!-- ===================== 第5组: 开源代码 ===================== -->
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>开源</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>GitHub be-huge/insulation</string>
			<key>action</key>
			<string>openSourceCode</string>
		</dict>
	</array>
</dict>
</plist>
