#!/bin/bash

# CPUthermal postrm
# 卸载/清除后重启 thermalmonitord（此时 dylib 已删除，进程会以无插件状态启动）

case "$1" in
    remove)
        # 文件已删除，杀掉 thermalmonitord 让其以无插件状态重启
        killall -q thermalmonitord 2>/dev/null || true
        ;;
    purge)
        # 完全清除：删除偏好 + 杀进程
        rm -f /var/mobile/Library/Preferences/com.huayuarc.CPUthermal.plist 2>/dev/null || true
        killall -q thermalmonitord 2>/dev/null || true
        ;;
    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;
esac
exit 0
