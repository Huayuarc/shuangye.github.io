#!/bin/sh
set -eu
SCHEME=@SCHEME@
MODE=@MODE@
case "$MODE:${1:-}" in postinst:configure|prerm:remove|prerm:upgrade|prerm:deconfigure) ;; *) exit 0 ;; esac
LABEL=com.huayuarc.sbjetsamguard
case "$SCHEME" in
 rootless) PREFIX=/var/jb; CTL=/var/jb/bin/launchctl; [ -x "$CTL" ] || CTL=/var/jb/usr/bin/launchctl; [ -x "$CTL" ] || CTL=/bin/launchctl ;;
 roothide) PREFIX=''; CTL=/usr/bin/launchctl; [ -x "$CTL" ] || CTL=/bin/launchctl ;;
 *) exit 1 ;;
esac
HELPER="$PREFIX/usr/libexec/sbjetsamguard"
PLIST="$PREFIX/Library/LaunchDaemons/$LABEL.plist"
[ -x "$CTL" ] || { echo 'SBJetsamGuard: launchctl missing' >&2; exit 1; }
if "$CTL" print "system/$LABEL" >/dev/null 2>&1; then
 "$CTL" bootout "system/$LABEL" || "$CTL" unload "$PLIST" || true
 if "$CTL" print "system/$LABEL" >/dev/null 2>&1; then echo 'SBJetsamGuard: daemon still registered' >&2; exit 1; fi
fi
[ "$MODE" = postinst ] || exit 0
[ -f "$HELPER" ] && [ -f "$PLIST" ] || { echo 'SBJetsamGuard: payload missing' >&2; exit 1; }
chown 0:0 "$HELPER" "$PLIST"
chmod 0755 "$HELPER"
chmod 0644 "$PLIST"
# RootHide launchctl patches arg0 to current physical root; use logical plist path.
"$CTL" enable "system/$LABEL" || true
"$CTL" bootstrap system "$PLIST" || true
if ! "$CTL" print "system/$LABEL" >/dev/null 2>&1; then "$CTL" load -w "$PLIST" || true; fi
"$CTL" print "system/$LABEL" >/dev/null || { echo 'SBJetsamGuard: daemon registration failed' >&2; exit 1; }
exit 0
