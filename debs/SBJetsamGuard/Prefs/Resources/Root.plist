			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>内存优化</string>
			<key>footerText</key>
			<string>普通优化只作用于 helper 当前进程，使用有界预算并在低可用内存、超时或压力条件下自动停止，结束后释放全部临时内存。</string>
		</dict>
