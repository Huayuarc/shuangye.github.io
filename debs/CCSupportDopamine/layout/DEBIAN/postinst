#!/bin/sh
set -e
CCDIR=/var/mobile/Library/ControlCenter
[ -d /var/jb ] && CCDIR=/var/jb/var/mobile/Library/ControlCenter
mkdir -p "$CCDIR"
DEFAULT="$CCDIR/ModuleConfiguration.plist"
CCS="$CCDIR/ModuleConfiguration_CCSupport.plist"
if [ ! -f "$CCS" ] && [ -f "$DEFAULT" ]; then
    cp -p "$DEFAULT" "$CCS" 2>/dev/null || true
fi
chown mobile:mobile "$CCDIR" "$CCS" 2>/dev/null || true
chmod 755 "$CCDIR" 2>/dev/null || true
chmod 644 "$CCS" 2>/dev/null || true
exit 0
