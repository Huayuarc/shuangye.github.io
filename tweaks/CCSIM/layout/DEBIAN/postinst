#!/bin/sh
# 上游 CCSIM 的 dylib/bundle 需要 roothide 的运行时路径补丁（bundle 里写死了
# /var/jb/usr/local/bin/CCSIMTool 这类路径，roothide 上真实不存在 /var/jb）。
# roothide 靠二进制旁边的 <path>.roothidepatch 标记来做这件事；dpkg 升级会把
# 原来的标记软链删掉，所以这里在每个受影响的二进制旁补一次。
set -e

PATCH_DYLIB=/usr/lib/DynamicPatches/AutoPatches.dylib
[ -e "$PATCH_DYLIB" ] || exit 0

for f in /Library/ControlCenter/Bundles/CCSIM.bundle/CCSIM \
         /usr/local/bin/CCSIMTool; do
    [ -f "$f" ] || continue
    ln -sf "$PATCH_DYLIB" "$f.roothidepatch" 2>/dev/null || true
done

exit 0
